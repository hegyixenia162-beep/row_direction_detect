# 不提交航片与算法渲染图片；本地文件不会因此被删除。
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp

# presentation 中只放经脱敏和压缩的公开示例图，允许 Git 跟踪。
!presentation/
!presentation/*.jpg

# Python 解释器缓存和虚拟环境不属于源码。
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/

# 本地最新版运行产物可随时重建，不进入源码提交。
outputs_latest/

# 常见编辑器、测试和操作系统临时文件。
.idea/
.vscode/
.pytest_cache/
.mypy_cache/
.DS_Store
Thumbs.db
